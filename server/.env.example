# TravelOS local AI server (server/.env)
# Copy to server/.env. Never commit real tokens.

PORT=8789

# Local-dev only. Production AI provider remains none in the native app.
AI_ENABLED=true
AI_SEMANTIC_SEARCH_ENABLED=true
AI_VISION_ENABLED=false
AI_VOICE_ENABLED=false

# Provider: ollama (default) | openai_compatible
# openai_compatible is for a future dedicated HF Inference Endpoint / OpenAI-compatible URL.
# Do not put HF_TOKEN in the Expo app or EXPO_PUBLIC_* vars.
AI_PROVIDER=ollama
AI_BASE_URL=http://127.0.0.1:11434
AI_CHAT_MODEL=qwen3:4b
AI_EMBEDDING_MODEL=bge-m3
# Documented only. Optional listwise Discover rerank uses AI_CHAT_MODEL when AI_RERANK_ENABLED=true.
# AI_RERANKER_MODEL=

# Aliases still accepted:
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:4b
# OLLAMA_EMBED_MODEL=bge-m3

# Only for AI_PROVIDER=openai_compatible (server-side only):
# AI_BASE_URL=https://YOUR_ENDPOINT.endpoints.huggingface.cloud/v1
# AI_API_KEY=
# HF_TOKEN=

# Optional. Google Time Zone API only — never reuse GOOGLE_MAPS_API_KEY.
# Restrict this key to the Time Zone API. Served at POST /geo/timezone for
# local-dev destination enrichment. Production cloud proxy remains Phase 6.
# GOOGLE_TIMEZONE_API_KEY=

# Optional. Google Directions API only — never reuse GOOGLE_MAPS_API_KEY.
# Restrict this key to the Directions API. Served at POST /geo/directions.
# GOOGLE_DIRECTIONS_API_KEY=

# Optional. Google Cloud Vision API only — never reuse GOOGLE_MAPS_API_KEY.
# Restrict to Cloud Vision API. Served at POST /import/ocr-extract.
# GOOGLE_VISION_API_KEY=

# Discover listwise rerank (qwen). No BGE install. Off by default.
# AI_RERANK_ENABLED=false

# Native app (repo root .env.local) — loopback only:
# EXPO_PUBLIC_TRAVELOS_AI_URL=http://127.0.0.1:8789