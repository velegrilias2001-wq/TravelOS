# Copy to .env.local at the repo root. Never commit real values.
#
# Required for Android maps / place search (app.config.js fails closed if missing):
GOOGLE_MAPS_API_KEY=

# Optional. Loopback AI server URL only. Cloud hosts are ignored by the native client.
# EXPO_PUBLIC_TRAVELOS_AI_URL=http://127.0.0.1:8789

# Local AI server secrets live in server/.env (see server/.env.example).
# Never put HF_TOKEN / AI_API_KEY into EXPO_PUBLIC_* variables.
