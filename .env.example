# Copy to .env.local at the repo root. Never commit real values.
#
# Required for maps / place search (app.config.js fails closed if missing).
# Android: restrict to package com.travelos.app + signing SHA-1.
# iOS (when rebuilt): also enable Maps SDK for iOS and restrict to bundle com.travelos.app.
GOOGLE_MAPS_API_KEY=

# TravelOS AI proxy base URL (chat / retrieve / explain / geo / OCR).
# Loopback (default) for local-dev + adb reverse:
# EXPO_PUBLIC_TRAVELOS_AI_URL=http://127.0.0.1:8789
#
# Preview/production: HTTPS URL of your TravelOS AI proxy only.
# Never put AI_API_KEY / HF_TOKEN here — keys stay in server/.env.
# EXPO_PUBLIC_TRAVELOS_AI_URL=https://YOUR_TRAVELOS_AI_PROXY
#
# LAN http preview (emulator → host LAN IP) requires explicit cleartext:
# EXPO_PUBLIC_TRAVELOS_AI_ALLOW_CLEARTEXT=true

# Local AI server secrets live in server/.env (see server/.env.example),
# including optional GOOGLE_TIMEZONE_API_KEY for POST /geo/timezone.
# Never put HF_TOKEN / AI_API_KEY / GOOGLE_TIMEZONE_API_KEY into EXPO_PUBLIC_* variables.
